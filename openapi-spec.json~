              "type": "string",
              "format": "uuid"
            },
            "description": "Session ID (UUID format)"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment processed successfully (COMPLETED or FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
