# Copy this file to .env and fill in real values before running locally.
# Never commit .env to version control — it is listed in .gitignore.

# Secret key used to sign and verify JWT tokens.
# Must be a cryptographically random string of at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-me

# HTTP port the server listens on (optional, defaults to 3001).
PORT=3001

# Comma-separated list of origins allowed to make cross-origin requests.
# In development, defaults to http://localhost:3000 and http://localhost:3001.
# In production this MUST be set explicitly — no origins are allowed by default.
# Supports exact origins and wildcard subdomain patterns (e.g. https://*.example.com).
# Example: CORS_ALLOWED_ORIGINS=https://app.chronopay.com,https://*.chronopay.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: encrypt idempotency payloads stored in Redis with AES-256-GCM.
# Leave disabled unless you have generated and securely provisioned 32-byte base64 keys.
IDEMPOTENCY_REDIS_ENCRYPTION_ENABLED=false
IDEMPOTENCY_REDIS_ENCRYPTION_ACTIVE_KEY_ID=
IDEMPOTENCY_REDIS_ENCRYPTION_ACTIVE_KEY=
# Comma-separated key-id:base64-key entries kept temporarily for decryption during rotation.
IDEMPOTENCY_REDIS_ENCRYPTION_PREVIOUS_KEYS=

# ─── Anti-fraud heuristics for booking-intent creation ─────────────────────────
# Combined by FraudScorer in src/middleware/fraudScoring.ts:
#   per-actor velocity, user-agent/device-fingerprint mismatch,
#   disposable-email detection, and shared IP/fingerprint co-occurrence.
# Scores >= threshold are stepped up: challenge response in "challenge" mode,
# or a quarantine entry (with the intent retained for HITL review) in
# "quarantine" mode. Every scored intent also emits a `fraud_score` audit event.
FRAUD_STEP_UP_MODE=challenge
FRAUD_STEP_UP_THRESHOLD=2
FRAUD_VELOCITY_WINDOW_MS=60000
FRAUD_MAX_INTENTS=5
# Comma-separated list of disposable email domains treated as high-risk.
FRAUD_DISPOSABLE_LIST=mailinator.com,trashmail.com,tempmail.com
# Model version label threaded into the fraud-drift histogram (not a gating knob).
FRAUD_MODEL_VERSION=2025-q1-r3
# Feature-snapshot spec version and sampling rate (0.0 disables snapshotting).
FRAUD_FEATURE_SPEC_VERSION=v1.1.0
FRAUD_FEATURE_SAMPLING_RATE=1.0
