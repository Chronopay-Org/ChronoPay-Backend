# Copy this file to .env and fill in real values before running locally.
# Never commit .env to version control — it is listed in .gitignore.

# Secret key used to sign and verify JWT tokens.
# Must be a cryptographically random string of at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-me

# HTTP port the server listens on (optional, defaults to 3001).
PORT=3001

# Comma-separated list of origins allowed to make cross-origin requests.
# In development, defaults to http://localhost:3000 and http://localhost:3001.
# In production this MUST be set explicitly — no origins are allowed by default.
# Supports exact origins and wildcard subdomain patterns (e.g. https://*.example.com).
# Example: CORS_ALLOWED_ORIGINS=https://app.chronopay.com,https://*.chronopay.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: encrypt idempotency payloads stored in Redis with AES-256-GCM.
# Leave disabled unless you have generated and securely provisioned 32-byte base64 keys.
IDEMPOTENCY_REDIS_ENCRYPTION_ENABLED=false
IDEMPOTENCY_REDIS_ENCRYPTION_ACTIVE_KEY_ID=
IDEMPOTENCY_REDIS_ENCRYPTION_ACTIVE_KEY=
# Comma-separated key-id:base64-key entries kept temporarily for decryption during rotation.
IDEMPOTENCY_REDIS_ENCRYPTION_PREVIOUS_KEYS=

# ── Settlement Finality Reconciler (#804) ────────────────────────────────
# Horizon RPC endpoints used by the settlement finality reconciler. The worker
# is skipped at boot when none are configured.
# Example: HORIZON_URLS=https://horizon-testnet.stellar.org,https://horizon.stellar.org
HORIZON_URLS=

# Stellar network passphrase (e.g. "Test SDF Network ; September 2015" for
# testnet, "Public Global Stellar Network ; September 2015" for mainnet).
STELLAR_NETWORK_PASSPHRASE=

# Ledger confirmations required before a settlement is marked payout_ready.
MIN_LEDGER_CONFIRMATIONS=3

# Set to "true" to disable the settlement finality reconciler worker at boot.
SETTLEMENT_RECONCILER_DISABLED=false

# Poll interval (ms) between reconciliation passes (defaults to 5000).
SETTLEMENT_RECONCILER_POLL_INTERVAL_MS=5000
