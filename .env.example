# Copy this file to .env and fill in real values before running locally.
# Never commit .env to version control — it is listed in .gitignore.

# Redis connection used for idempotency, caching, and rate limiting.
# The default connects to a local Redis instance without authentication.
REDIS_URL=redis://localhost:6379

# PostgreSQL connection used by the database repositories and migrations.
# The default assumes a local ChronoPay database and standard development credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chronopay

# Secret key used to sign and verify JWT tokens.
# Must be a cryptographically random string of at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-me

# HTTP port the server listens on (optional, defaults to 3001).
PORT=3001

# Supplier tier alert evaluation (defaults to hourly; set disabled=true to skip).
TIER_ALERT_SCHEDULER_DISABLED=false
# Optional evaluation interval in milliseconds (default 3600000).
TIER_ALERT_INTERVAL_MS=
# Partner quota store failure behavior: "open" allows requests when quota
# checks fail (default); "closed" returns 503 Service Unavailable.
QUOTA_FAIL_MODE=open
# Per-check budget for /health/ready DB and Redis probes (ms, defaults to 2000).
# READINESS_TIMEOUT_MS=2000

# Comma-separated list of origins allowed to make cross-origin requests.
# In development, defaults to http://localhost:3000 and http://localhost:3001.
# In production this MUST be set explicitly — no origins are allowed by default.
# Supports exact origins and wildcard subdomain patterns (e.g. https://*.example.com).
# Example: CORS_ALLOWED_ORIGINS=https://app.chronopay.com,https://*.chronopay.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional checkout redirect allowlist (exact host[:port], comma-separated).
# When unset, a valid APP_URL supplies its host. Without either, redirects are denied.
# CHECKOUT_REDIRECT_ALLOWED_HOSTS=app.example,checkout.example:8443
# APP_URL=https://app.example

# Optional: encrypt idempotency payloads stored in Redis with AES-256-GCM.
# Leave disabled unless you have generated and securely provisioned 32-byte base64 keys.
IDEMPOTENCY_REDIS_ENCRYPTION_ENABLED=false
IDEMPOTENCY_REDIS_ENCRYPTION_ACTIVE_KEY_ID=
IDEMPOTENCY_REDIS_ENCRYPTION_ACTIVE_KEY=
# Comma-separated key-id:base64-key entries kept temporarily for decryption during rotation.
IDEMPOTENCY_REDIS_ENCRYPTION_PREVIOUS_KEYS=

# TOTP MFA. Master key used to encrypt per-user TOTP secrets at rest
# (must be exactly 32 bytes as hex or base64; generate with the same node crypto command as JWT_SECRET).
# If unset, the MFA endpoints return 500 "MFA is not configured".
MFA_ENCRYPTION_KEY=
# Separate secret that signs the short-lived MFA challenge tokens consumed by requireFreshMfa.
# If unset, MFA challenges cannot be issued/verified.
MFA_CHALLENGE_SECRET=
# Optional: issuer label embedded in otpauth:// URIs (defaults to "ChronoPay").
MFA_ISSUER=ChronoPay
# Optional: how long a successful MFA verification grants access before re-verification (ms, default 900000 = 15 min).
MFA_FRESHNESS_MS=900000
# Optional: number of adjacent 30s windows accepted as valid TOTP codes (default 1).
MFA_WINDOW_PERIODS=1
# Optional: lifetime of an MFA challenge token in seconds (default 300).
MFA_CHALLENGE_TTL_SEC=300
# Optional: require a fresh MFA challenge (x-chronopay-mfa header) on customer
# booking refunds. Defaults to on when NODE_ENV=production, off otherwise.
MFA_REQUIRED_FOR_REFUNDS=true

# ─── Hold Auto-Refund Worker ────────────────────────────────────────────────
# Background worker that polls for refundable holds whose holdUntilMs has
# elapsed and issues automatic refunds via BookingIntentService.autoRefundHold.
# Set HOLD_AUTO_REFUND_DISABLED=true to skip (e.g. read-only replicas).
# HOLD_AUTO_REFUND_DISABLED=true
# How often the worker runs in milliseconds (default: 60000 = 1 minute).
# HOLD_AUTO_REFUND_INTERVAL_MS=60000
# Maximum holds to process per cycle (default: 100).
# HOLD_AUTO_REFUND_BATCH_SIZE=100
# Safety circuit-breaker: skip the cycle if more than this many holds are
# expired at once, to prevent runaway mass-refunds (default: 1000).
# HOLD_AUTO_REFUND_SAFETY_THRESHOLD=1000
# Optional: bearer token protecting GET /metrics. When set, requests must send
# "Authorization: Bearer <token>" (compared in constant time). Unset outside
# production leaves /metrics open for local use. In production, startup fails
# unless this is set or METRICS_PUBLIC=true is set explicitly.
# Prometheus scrape config:
#   scrape_configs:
#     - job_name: chronopay
#       authorization:
#         type: Bearer
#         credentials: <same value as METRICS_AUTH_TOKEN>
METRICS_AUTH_TOKEN=
# Set to true only to explicitly expose /metrics without a token in production.
METRICS_PUBLIC=false
